local function makeNavButton(id, label)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -12, 0, 40)
	btn.Position = UDim2.fromOffset(6, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.BorderSizePixel = 0
