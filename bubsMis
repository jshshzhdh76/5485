-- ============ 横向 UI 框架（窄窗口版·可最小化·纯界面，无作弊逻辑） ============
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local UIS = game:GetService("UserInputService")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "UI框架"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = PlayerGui

local Colors = {
	navBg = Color3.fromRGB(244, 249, 254),
	panelBg = Color3.fromRGB(255, 255, 255),
	line = Color3.fromRGB(220, 232, 246),
	accent = Color3.fromRGB(91, 126, 185),
	accentDark = Color3.fromRGB(74, 112, 180),
	text = Color3.fromRGB(58, 90, 140),
	sub = Color3.fromRGB(142, 168, 200),
	on = Color3.fromRGB(108, 140, 190),
	off = Color3.fromRGB(220, 232, 246),
}

local function makeText(txt, size, color, bold)
	local t = Instance.new("TextLabel")
	t.Text = txt
	t.TextSize = size
	t.TextColor3 = color or Colors.text
	t.Font = Enum.Font.GothamMedium
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	if bold then t.Font = Enum.Font.GothamBold end
	return t
end

local function makeCorner(radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	return c
end

