-- 滑条（弹性轨道，随窗口宽度自适应）
local function addSlider(parent, offsetY, label, minV, maxV, defV, suffix, onChanged)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -20, 0, 30)
	row.Position = UDim2.fromOffset(10, offsetY)
	row.BackgroundTransparency = 1
	row.Parent = parent
	row:AddTag("UI框架_滑条行")
	local lbl = makeText(label, 11, Colors.text)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Size = UDim2.fromOffset(72, 30)
	lbl.Parent = row
	local val = makeText(tostring(defV) .. suffix, 11, Colors.accent, true)
	val.TextXAlignment = Enum.TextXAlignment.Right
	val.Size = UDim2.fromOffset(40, 30)
	val.Position = UDim2.new(1, -40, 0, 0)
	val.Parent = row
	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(76, 12)
	track.Size = UDim2.new(0, 1, 0, 5)
	track.Size = UDim2.new(1, -116, 0, 5)
	track.Size = UDim2.fromOffset(0, 5)
	track.Size = UDim2.new(1, -120, 0, 5)
	track.BackgroundColor3 = Colors.line
	track.BorderSizePixel = 0
	track.Parent = row
	local tc = makeCorner(3)
	tc.Parent = track
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Colors.accent
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale((defV - minV) / (maxV - minV), 1)
	fill.Parent = track
	local fc = makeCorner(3)
	fc.Parent = fill
	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(14, 14)
	knob.Position = UDim2.fromScale((defV - minV) / (maxV - minV), 0.5)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	local kc = makeCorner(7)
	kc.Parent = knob
	local dragging = false
	local function setValue(v)
		v = math.clamp(v, minV, maxV)
		local ratio = (v - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		val.Text = tostring(math.floor(v)) .. suffix
		if onChanged then onChanged(v) end
	end
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
	end)
	knob.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local absPos = track.AbsolutePosition
			local absSize = track.AbsoluteSize
			local x = (input.Position.X - absPos.X) / absSize.X
			setValue(minV + x * (maxV - minV))
		end
	end)
	row:AddTag("UI框架_控件")
	return { setValue = setValue }
end

-- 开关
local function addToggle(parent, offsetY, label, defOn, onChanged)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -20, 0, 30)
	row.Position = UDim2.fromOffset(10, offsetY)
	row.BackgroundTransparency = 1
	row.Parent = parent
	row:AddTag("UI框架_开关行")
	local lbl = makeText(label, 11, Colors.text)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Size = UDim2.fromOffset(110, 30)
	lbl.Parent = row
	local isOn = defOn
	local track = Instance.new("Frame")
	track.Position = UDim2.new(1, -46, 0, 3)
	track.Size = UDim2.fromOffset(36, 24)
	track.BackgroundColor3 = isOn and Colors.on or Colors.off
	track.BorderSizePixel = 0
	track.Parent = row
	local tc = makeCorner(12)
	tc.Parent = track
	local knob = Instance.new("Frame")
 	knob.Size = UDim2.fromOffset(18, 18)
 	knob.Position = UDim2.fromOffset(isOn and 16 or 3, 3)
 	knob.BackgroundColor3 = Color3.new(1, 1, 1)
 	knob.BorderSizePixel = 0
 	knob.Parent = track
 	local kc = makeCorner(9)
 	kc.Parent = knob
 	local function setOn(v)
 		isOn = v
 		track.BackgroundColor3 = v and Colors.on or Colors.off
 		knob.Position = UDim2.fromOffset(v and 16 or 3, 3)
 		if onChanged then onChanged(v) end
 	end
 	track.InputBegan:Connect(function(input)
 		if input.UserInputType == Enum.UserInputType.MouseButton1 then setOn(not isOn) end
 	end)
 	row:AddTag("UI框架_控件")
 	return { setOn = setOn }
 end
