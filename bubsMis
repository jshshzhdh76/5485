	btn:AddTag("UI框架_导航_" .. id)
	local btxt = makeText(label, 13, Colors.text)
	btxt.TextXAlignment = Enum.TextXAlignment.Left
	btxt.Position = UDim2.fromOffset(10, 0)
	btxt.Size = UDim2.new(1, -16, 1, 0)
	btxt.Parent = btn
	local bg = Instance.new("Frame")
	bg.BackgroundColor3 = Colors.accent
	bg.BorderSizePixel = 0
