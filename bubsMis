 -- ========== 导航切换 ==========
 local function setPage(id)
 	if currentPage == id then return end
 	for k, p in pairs(pages) do
 		p.Visible = (k == id)
 	end
 	currentPage = id
 	for k, b in pairs(pageBtns) do
 		b.active = (k == id)
 		b.bg.Visible = b.active
 		b.txt.TextColor3 = b.active and Color3.new(1, 1, 1) or Colors.text
 	end
 end
 -- 创建导航按钮
 local y = 0
 for _, cfg in ipairs({
 	{ id = "aim", label = "自瞄" },
 	{ id = "esp", label = "透视" },
 	{ id = "visual", label = "视觉设置" },
 }) do
 	local b = makeNavButton(cfg.id, cfg.label)
 	b.btn.Position = UDim2.fromOffset(10, y)
 	b.btn.Size = UDim2.new(1, -20, 0, 46)
 	b.btn.Parent = NavList
 	b.bg.Visible = false
 	b.btn.InputBegan:Connect(function(input)
 		if input.UserInputType == Enum.UserInputType.MouseButton1 then
 			setPage(cfg.id)
 		end
 	end)
 	pageBtns[cfg.id] = b
 	y = y + 54
 end
