-- ============ 最小化按钮（减号/加号切换） ============
local function makeMinBtn(char)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(28, 28)
	btn.Position = UDim2.new(1, -34, 0, 3)
	btn.BackgroundColor3 = Colors.accent
	btn.BorderSizePixel = 0
	btn.Text = char
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextSize = 18
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.ZIndex = 5
	btn.Parent = TitleBar
	local bc = makeCorner(8)
	bc.Parent = btn
	return btn
end

local minusBtn = makeMinBtn("－")
local plusBtn = makeMinBtn("＋")
plusBtn.Visible = false

local minimized = false
local function minimize()
	if minimized then return end
	minimized = true
	for _, child in ipairs(Window:GetChildren()) do
		if child ~= TitleBar then child.Visible = false end
	end
	Window.Size = UDim2.fromOffset(DEFAULT_W, BAR_H)
	Window.Position = UDim2.fromScale(0.5, 0.5)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	minusBtn.Visible = false
	plusBtn.Visible = true
end

local function restore()
	if not minimized then return end
	minimized = false
	for _, child in ipairs(Window:GetChildren()) do
		if child ~= TitleBar then child.Visible = true end
	end
	Window.Size = UDim2.fromOffset(DEFAULT_W, DEFAULT_H)
	Window.Position = UDim2.fromScale(0.5, 0.5)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	plusBtn.Visible = false
	minusBtn.Visible = true
end

minusBtn.MouseButton1Click:Connect(minimize)
plusBtn.MouseButton1Click:Connect(restore)

local dragging = false
TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
end)
TitleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local newX = input.Position.X - Window.AbsoluteSize.X * 0.5
		local newY = input.Position.Y - Window.AbsoluteSize.Y * 0.5
		Window.Position = UDim2.fromOffset(math.clamp(newX,0,10000), math.clamp(newY,0,10000))
	end
end)

