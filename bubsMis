-- 导航按钮工厂
local function makeNavButton(id, label)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 46)
	btn.Position = UDim2.fromOffset(10, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = NavList
	btn:AddTag("UI框架_导航_" .. id)
	-- 按钮文字
	local btxt = makeText(label, 14, Colors.text)
	btxt.TextXAlignment = Enum.TextXAlignment.Left
	btxt.Position = UDim2.fromOffset(14, 0)
	btxt.Size = UDim2.new(1, -28, 1, 0)
	btxt.Parent = btn
	-- 高亮
	local bg = Instance.new("Frame")
	bg.BackgroundColor3 = Colors.accent
	bg.BorderSizePixel = 0
	bg.Size = UDim2.fromScale(1, 1)
	bg.Parent = btn
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Colors.accent, Colors.accentDark)
	grad.Parent = bg
	bg:AddTag("UI框架_按钮底")
	btn:AddTag("UI框架_按钮父")
	bg.ZIndex = 1
	btxt.ZIndex = 2
	return { btn = btn, bg = bg, txt = btxt, id = id, active = false }
end

-- 页面工厂
local function makePage()
	local page = Instance.new("Frame")
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.Size = UDim2.new(1, 0, 1, 0)
	page.Visible = false
	page.Parent = Root
	return page
end

-- 在页面内创建"区段卡片"
local function addSection(page, title, offsetY, height)
	local sec = Instance.new("Frame")
	sec.Position = UDim2.fromOffset(20, offsetY)
	sec.Size = UDim2.new(1, -40, 0, height)
	sec.BackgroundColor3 = Colors.panelBg
	sec.BorderSizePixel = 0
	sec.Parent = page
	sec:AddTag("UI框架_区段")
	local c = makeCorner(14)
	c.Parent = sec
	local st = makeText(title, 13, Colors.accent, true)
	st.TextXAlignment = Enum.TextXAlignment.Left
	st.Position = UDim2.fromOffset(16, 10)
	st.Size = UDim2.fromOffset(200, 24)
	st.Parent = sec
	return sec
end

-- ========== 控件工厂 ==========
-- 滑条（可拖动调节大小/数值）
local function addSlider(parent, offsetY, label, minV, maxV, defV, suffix, onChanged)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -32, 0, 34)
	row.Position = UDim2.fromOffset(16, offsetY)
	row.BackgroundTransparency = 1
	row.Parent = parent
	row:AddTag("UI框架_滑条行")

	local lbl = makeText(label, 12, Colors.text)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Size = UDim2.fromOffset(150, 34)
	lbl.Parent = row

	local val = makeText(tostring(defV) .. suffix, 12, Colors.accent, true)
	val.TextXAlignment = Enum.TextXAlignment.Right
	val.Size = UDim2.fromOffset(60, 34)
	val.Position = UDim2.new(1, -60, 0, 0)
	val.Parent = row
	row:AddTag("UI框架_滑条值")

	-- 轨道
	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(150, 14)
	track.Size = UDim2.new(0, 180, 0, 6)
	track.BackgroundColor3 = Colors.line
	track.BorderSizePixel = 0
	track.Parent = row
	local tc = makeCorner(3)
	tc.Parent = track

	-- 填充
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Colors.accent
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale((defV - minV) / (maxV - minV), 1)
	fill.Parent = track
	local fc = makeCorner(3)
	fc.Parent = fill
	track:AddTag("UI框架_滑条轨道")

	-- 滑块
	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(18, 18)
	knob.Position = UDim2.fromScale((defV - minV) / (maxV - minV), 0.5)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	local kc = makeCorner(9)
	kc.Parent = knob
	track:AddTag("UI框架_滑条滑块")

	local dragging = false
	local function setValue(v)
		v = math.clamp(v, minV, maxV)
		local ratio = (v - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		val.Text = tostring(math.floor(v)) .. suffix
		if onChanged then onChanged(v) end
	end
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)
	knob.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	-- 拖动更新
	local uis = game:GetService("UserInputService")
	uis.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local absPos = track.AbsolutePosition
			local absSize = track.AbsoluteSize
			local x = (input.Position.X - absPos.X) / absSize.X
			setValue(minV + x * (maxV - minV))
		end
	end)
	row:AddTag("UI框架_控件")
	return { setValue = setValue, track = track }
end

-- 开关
local function addToggle(parent, offsetY, label, defOn, onChanged)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -32, 0, 34)
	row.Position = UDim2.fromOffset(16, offsetY)
	row.BackgroundTransparency = 1
	row.Parent = parent
	row:AddTag("UI框架_开关行")

	local lbl = makeText(label, 12, Colors.text)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Size = UDim2.fromOffset(150, 34)
	lbl.Parent = row

	local isOn = defOn
	-- 轨道
	local track = Instance.new("Frame")
	track.Position = UDim2.new(1, -62, 0, 4)
	track.Size = UDim2.fromOffset(46, 26)
	track.AnchorPoint = Vector2.new(0, 0)
	track.BackgroundColor3 = isOn and Colors.on or Colors.off
	track.BorderSizePixel = 0
	track.Parent = row
	local tc = makeCorner(13)
	tc.Parent = track
	-- 滑块
	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.Position = UDim2.fromOffset(isOn and 24 or 3, 3)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	local kc = makeCorner(10)
	kc.Parent = knob

	local function setOn(v)
		isOn = v
		track.BackgroundColor3 = v and Colors.on or Colors.off
		knob.Position = UDim2.fromOffset(v and 24 or 3, 3)
		if onChanged then onChanged(v) end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			setOn(not isOn)
		end
	end)
	row:AddTag("UI框架_控件")
	return { setOn = setOn }
end

